    "? PlanetsLibTiers",
    "(?) Cosmic-Social-Distancing >= 1.0.2",
    "! MT-lib"
  ],
  "package": {
    "ignore": ["**/*.bat","**/*.py","**/*.sh","**/*.exe","**/*.ps1","test-mods/**",".opencode/**","helper_scripts/**",".claude/**","CLAUDE.md",".env",".env.*"]
